{
  "name": "montyv-github-io",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "sync:catalog": "node scripts/sync-monty-catalog.mjs",
    "sync:catalog:scholar": "node scripts/sync-monty-catalog.mjs --sync-scholar",
    "generate:indexes": "node scripts/generate-content-index.mjs",
    "generate:indexes:pdf": "node scripts/generate-content-index.mjs --parse-pdfs",
    "predev": "node scripts/generate-home-sections.mjs",
    "dev": "node scripts/run-next-with-distdir.mjs dev",
    "prebuild": "node scripts/warn-missing-envitrace-catalog.mjs && node scripts/generate-home-sections.mjs",
    "build": "node scripts/run-next-with-distdir.mjs build",
    "start": "npx serve@latest out",
    "preview": "npx serve@latest out",
    "postbuild": "node scripts/cleanup-build-artifacts.mjs && node scripts/sync-next-build-to-out.mjs && next-sitemap && node scripts/copy-sitemap-to-out.mjs"
  },
  "dependencies": {
    "cheerio": "^1.0.0-rc.12",
    "next": "^15.1.0",
    "pdf-parse": "^1.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "next-sitemap": "^4.2.3",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20 <23"
  }
}
